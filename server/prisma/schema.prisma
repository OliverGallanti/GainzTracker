generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  googleId           String   @unique
  email              String   @unique
  name               String?
  avatarUrl          String?
  heightCm           Float? // one-time profile value, not historized like weight/bodyFatPercent
  weightGoalKg       Float? // a target, not historized — re-editing replaces it
  bodyFatGoalPercent Float?
  sex                String? // 'male' | 'female' — app-validated, not a DB enum; only used for the Big 4 strength-standard lookup, everything else works without it
  age                   Int? // years — a plain number, not birthDate; drifts by a year at most, fine for a TDEE estimate
  activityLevel         String? // one of ACTIVITY_LEVELS' keys in src/lib/tdee.js, app-validated like `sex`
  mealNames             String[] @default(["Breakfast", "Lunch", "Dinner"]) // the user's own meal slots for the day, in order — a preference list like WorkoutSplit.days
  // DEPRECATED — superseded by LiftGoal. Nothing reads or writes these any more;
  // they're kept only so the migration can be rolled back, and are dropped in a
  // separate, later migration once the switch has been verified.
  deadliftGoalKg        Float?
  squatGoalKg           Float?
  benchPressGoalKg      Float?
  overheadPressGoalKg   Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  liftGoals       LiftGoal[]
  sessions        Session[]
  authTokens      AuthToken[]
  weightEntries   WeightEntry[]
  macroEntries    MacroEntry[]
  workoutRoutines WorkoutRoutine[]
  workoutSets     WorkoutSet[]
  credentials     Credential[]
  macroGoal       MacroGoal?
  workoutSplits   WorkoutSplit[]
  splitLogs       SplitLog[]
  savedFoods      SavedFood[]
}

// A per-lift target weight, one row per (user, lift). Keyed by the same
// display name WorkoutSet.exerciseName uses ("Bench Press"), so there's no
// lift-to-column mapping to maintain and a new lift needs no schema change.
// The unique index also serves lookups by userId, since userId leads it.
model LiftGoal {
  id           String @id @default(cuid())
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseName String
  goalKg       Float

  @@unique([userId, exerciseName])
}

// A training split (e.g. 6-day PPL) — the day types the user picks from, listed
// in a suggested order, not tied to calendar weekdays. Only one is `active` per
// user; older splits and their logs are kept (not deleted) so switching
// programs doesn't lose history.
model WorkoutSplit {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  days      String[] // e.g. ["Push","Pull","Legs","Push","Pull","Legs"]
  // Days per week that make a good week for the weekly streak. Null (routines made
  // before this existed) means "as many as `days` lists", worked out client-side.
  daysPerWeek Int?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  logs SplitLog[]

  @@index([userId])
}

// One yes/no log for a calendar day, against whichever of the split's days the
// user chose that day (dayIndex indexes WorkoutSplit.days; no forced order).
model SplitLog {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  splitId         String
  split           WorkoutSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)
  dayIndex        Int
  completed       Boolean
  loggedAt        DateTime     @default(now())
  durationMinutes Int? // manual entry — what you actually did that session, not a stopwatch

  workoutSets WorkoutSet[]

  @@index([userId, loggedAt])
  @@index([splitId, loggedAt])
}

// A user's current daily macro targets — a singleton per user (re-editing
// replaces it via upsert), not a per-day row.
model MacroGoal {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  proteinG      Float
  fatG          Float
  carbsG        Float
  calorieTarget Int?
  updatedAt     DateTime @updatedAt
}

// A registered WebAuthn passkey. Always an additional credential on an
// account created via Google — see server/README.md for why v1 doesn't
// support passkey-only signup.
model Credential {
  id          String    @id // base64url credential ID from the authenticator
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKey   Bytes
  counter     BigInt    @default(0)
  transports  String[]  @default([])
  deviceLabel String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  @@index([userId])
}

// Server-side session store backing @fastify/session (avoids adding Redis).
model Session {
  id        String   @id
  data      Json
  expiresAt DateTime
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Bearer tokens for clients that can't use the session cookie (the mobile app).
// Only a SHA-256 hash of the token is stored, so a database leak can't be replayed
// as logins. Revoked by deleting the row; there is no refresh: when one expires the
// app signs in with Google again.
model AuthToken {
  id        String   @id // sha256(token), hex
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model WeightEntry {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg       Float
  bodyFatPercent Float? // measured alongside weight (smart scale, calipers), so it lives on the same entry rather than its own table
  loggedAt       DateTime @default(now())
  note           String?

  @@index([userId, loggedAt])
}

model MacroEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  calories    Int
  proteinG    Float?
  carbsG      Float?
  fatG        Float?
  // Which of User.mealNames this was eaten as. Stored as the name itself, not a
  // reference: null (or a name the user has since renamed away) simply shows
  // under "Other", and the card only displays today, so nothing is orphaned for long.
  mealName    String?
  loggedAt    DateTime @default(now())

  @@index([userId, loggedAt])
}

// A food or recipe the user saved to log again: macros for ONE serving, so
// logging it is a servings multiplier. One row per name — saving the same name
// again updates it. Deliberately not ingredient-based (see server/README.md).
model SavedFood {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  calories  Int
  proteinG  Float?
  carbsG    Float?
  fatG      Float?
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

// Exercise list kept as JSON for v1 ([{ name, targetSets, targetReps, order }]) —
// normalize into a separate table later if per-exercise querying/editing needs grow.
model WorkoutRoutine {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  exercises Json
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workoutSets WorkoutSet[]

  @@index([userId])
}

model WorkoutSet {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineId    String?
  routine      WorkoutRoutine? @relation(fields: [routineId], references: [id], onDelete: SetNull)
  splitLogId   String? // ties an actually-performed set to the specific day it happened on; independent of routineId
  splitLog     SplitLog?       @relation(fields: [splitLogId], references: [id], onDelete: Cascade)
  exerciseName String
  weightKg     Float?
  reps         Int?
  performedAt  DateTime        @default(now())

  @@index([userId, performedAt])
  @@index([splitLogId])
}
