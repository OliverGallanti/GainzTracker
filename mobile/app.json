{
  "expo": {
    "name": "Gainz.Tracker",
    "slug": "gainz-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#053345",
    "android": {
      "package": "com.olivergallanti.gainztracker",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#053345",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to scan food barcodes",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Manrope",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Manrope_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Manrope_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Manrope_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Manrope_700Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "50f8c114-fc03-4738-a8f8-3b92515725eb"
      }
    },
    "owner": "olivergallanti"
  }
}
